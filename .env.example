# Obrigatório: development, test ou production. 'production' desliga a documentação em /docs.
NODE_ENV=development
# Postgres (docker compose creates the database and builds DATABASE_URL from these)
POSTGRES_USER=giross
POSTGRES_PASSWORD=giross
POSTGRES_DB=giross
# Host ports published by docker compose
POSTGRES_PORT=5432
API_PORT=3000
# Only when running outside docker (npm start / npm run seed):
# DATABASE_URL=postgresql://giross:giross@localhost:5432/giross
PORT=3000
SEARCH_RADIUS_KM=1
# Comma-separated UFs (e.g. SP,RJ). Empty loads all of Brazil.
SEED_UFS=
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
CACHE_TTL_ADDRESS_SECONDS=2592000
CACHE_TTL_RESULT_SECONDS=86400
CACHE_TTL_NOT_FOUND_SECONDS=3600
# Nominatim fallback (optional; defaults shown)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=bc_giross/1.0 (+https://github.com/owhenrique/bc_giross)
# Cache admin endpoints (DELETE /cache, DELETE /cache/:cep). Min. 12 characters; empty or unset disables them (404).
# CACHE_ADMIN_TOKEN=troque-por-um-token-longo
# Rate limit per client IP (optional; defaults shown)
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_SECONDS=60
# Where the client IP comes from behind a proxy: number of hops (1), 'loopback', a CIDR list. Empty = socket IP, X-Forwarded-For ignored.
# TRUST_PROXY=1
