# Postgres (docker compose creates the database and builds DATABASE_URL from these)
POSTGRES_USER=giross
POSTGRES_PASSWORD=giross
POSTGRES_DB=giross
# Host ports published by docker compose
POSTGRES_PORT=5432
API_PORT=3000
# Only when running outside docker (npm start / npm run seed):
# DATABASE_URL=postgresql://giross:giross@localhost:5432/giross
PORT=3000
SEARCH_RADIUS_KM=1
# Comma-separated UFs (e.g. SP,RJ). Empty loads all of Brazil.
SEED_UFS=
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
CACHE_TTL_ADDRESS_SECONDS=2592000
CACHE_TTL_RESULT_SECONDS=604800
CACHE_TTL_NOT_FOUND_SECONDS=3600
